+// Frameskip, driven by the frontend: with dsperate_frameskip=auto it says,
+// through the audio buffer status callback, which frames it would rather not
+// have drawn (its underrun flag), and DSperate's adaptive frameskip skips
+// whole display periods while it does, at most FS_LIMIT of them running, then
+// draws one. DSperate decides one frame ahead, so a skip asked for now lands
+// on the next frame: the frame presented then is the last one drawn.
+constexpr int FS_LIMIT = 2;
+bool fs_auto = false;
+bool fs_behind = false;
+bool fs_in_skip = false;
+int fs_left = 0;
+int fs_blocks = 0;
